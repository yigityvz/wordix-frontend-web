{
  "name": "wordix-frontend-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run build:api-core",
    "start": "ng serve wordix-frontend-web --host localhost --port 4200",
    "prebuild": "npm run build:api-core",
    "build": "ng build wordix-frontend-web",
    "build:api-core": "ng build angular-api-client-core",
    "prewatch": "npm run build:api-core",
    "watch": "ng build wordix-frontend-web --watch --configuration development",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\" \"projects/angular-api-client-core/src/**/*.ts\" angular.json package.json tsconfig.json tsconfig.app.json tsconfig.spec.json .postcssrc.json .prettierrc \"projects/angular-api-client-core/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\" \"projects/angular-api-client-core/src/**/*.ts\" angular.json package.json tsconfig.json tsconfig.app.json tsconfig.spec.json .postcssrc.json .prettierrc \"projects/angular-api-client-core/*.json\"",
    "pretest": "npm run build:api-core",
    "test": "ng test wordix-frontend-web",
    "test:api-core": "ng test angular-api-client-core"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@ngrx/effects": "^21.0.0",
    "@ngrx/router-store": "^21.0.0",
    "@ngrx/store": "^21.0.0",
    "keycloak-js": "^26.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.18",
    "@angular/cli": "^21.2.18",
    "@angular/compiler-cli": "^21.2.18",
    "@tailwindcss/postcss": "^4.3.2",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "postcss": "^8.5.16",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
